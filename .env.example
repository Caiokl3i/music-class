# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_NAME=music-class
APP_KEY=
APP_URL=http://${HOST}:${PORT}
# Enable during cutover/maintenance windows to block mutating requests (POST/PUT/PATCH/DELETE) with HTTP 503
# APP_READ_ONLY=false

# Session
SESSION_DRIVER=cookie

# Database
# Local development: empty uses SQLite (tmp/db.sqlite3).
# Production on Vercel + Supabase:
# - DATABASE_URL: Transaction pooler (port 6543) for serverless HTTP functions
# - DATABASE_DIRECT_URL: Direct connection (port 5432) for running migrations (db:migrate:prod)
# DB_CONNECTION=pg
# DATABASE_URL=postgres://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DATABASE_DIRECT_URL=postgres://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:5432/postgres
# DB_POOL_MAX=2

# Rate limiting
# Unset follows NODE_ENV (off in test, on in dev/prod).
# In production on serverless: configure Upstash Redis or leave empty to use Supabase PostgreSQL table rate_limit_buckets.
# RATE_LIMIT_ENABLED=1
# UPSTASH_REDIS_REST_URL=https://[endpoint].upstash.io
# UPSTASH_REDIS_REST_TOKEN=[token]

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# Comma-separated list used when NODE_ENV=production
# CORS_ORIGIN=https://music-class.vercel.app
# ALLOW_VERCEL_PREVIEW=true

# Signup: empty closes registration. Set a phrase to accept that invite only.
SIGNUP_INVITE_CODE=

# Optional. Default is ./backups (outside tmp/) — used only in SQLite environment
# BACKUP_DIR=

# Backup by email (Resend) — SQLite environment only
# RESEND_API_KEY=
# RESEND_FROM=Music Class <onboarding@resend.dev>
# BACKUP_EMAIL_TO=
