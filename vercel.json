{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=dev",
  "functions": {
    "api/index.js": {
      "includeFiles": "build/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
